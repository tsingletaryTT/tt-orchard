"""Shim for `tt-orchard`: put the checkout on the import path and run orchard.cli.

Link this file from a directory on PATH (`ln -s <checkout>/bin/tt-orchard ~/.local/bin/tt-orchard`). A link,
not a copy: the link follows the checkout, so an old copy cannot shadow a newer one. The checkout is found
from this file's real path, so the command works from any working directory.
"""
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.realpath(__file__))))

from orchard.cli import main  # noqa: E402

if __name__ == "__main__":
    sys.exit(main())
